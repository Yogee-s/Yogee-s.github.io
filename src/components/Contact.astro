---
import Icon from './Icon.astro';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="section-label">Contact</p>
    <div class="split">
      <header class="split-head" data-reveal>
        <h2 id="contact-title">Let's connect.</h2>
      </header>
      <div class="contact-body" data-reveal style="--d:.06s">
        <p class="contact-lead">
          Open to <strong>robotics software roles</strong> · Singapore · open to relocation.
        </p>
        <div class="contact-mail">
          <a class="contact-address" href="mailto:yogeeswaran99@gmail.com">yogeeswaran99@gmail.com</a>
          <button class="btn copy-btn" type="button" data-copy="yogeeswaran99@gmail.com"><Icon name="copy" /> <span>Copy</span></button>
        </div>
        <div class="contact-links">
          <a class="btn btn-primary" href="/assets/resume.pdf" target="_blank" rel="noopener"><Icon name="download" /> Resume</a>
          <a class="btn" href="https://www.linkedin.com/in/yogee-s" target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
          <a class="btn" href="https://github.com/Yogee-s" target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        </div>
      </div>
    </div>
  </div>
</section>
