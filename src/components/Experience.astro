---
import Icon from './Icon.astro';
import { experience } from '../data/experience';
import { rich } from '../lib/rich';
---
<section class="section experience" id="experience" aria-labelledby="exp-title">
  <div class="container">
    <p class="section-label">Experience</p>
    <div class="split">
      <header class="split-head" data-reveal>
        <h2 id="exp-title">Building robots across research labs and industry.</h2>
        <a class="btn" href="/assets/resume.pdf" target="_blank" rel="noopener"><Icon name="download" /> Full resume</a>
      </header>

      <ol class="timeline" data-reveal style="--d:.06s">
        {experience.map((r) => (
          <li class="tl-row">
            <p class="tl-date">
              {r.dates.split(' – ').map((d, i) => <span>{i > 0 && '– '}{d}</span>)}
            </p>
            <div class="tl-body">
              <h3 class="tl-title">
                {r.project ? (
                  <a href={`/work/${r.project}/`} data-case={r.project}><span class="tl-link-text"><span class="tl-role">{r.role}</span> <span class="tl-org"><span class="tl-sep">· </span>{r.org}</span></span><Icon name="arrow" size={13} /></a>
                ) : (
                  <>{r.role}{' '}<span class="tl-org"><span class="tl-sep">· </span>{r.org}</span></>
                )}
                {r.tag && <em class:list={['tl-tag', r.tag === 'Deployed' && 'is-live']}>{r.tag}</em>}
              </h3>
              <p class="tl-line" set:html={rich(r.line)} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
