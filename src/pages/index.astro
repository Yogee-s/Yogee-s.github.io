---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Overlay from '../components/Overlay.astro';
import { projects } from '../data/projects';
import '../styles/home.css';
import '../styles/case-study.css';
import '../styles/project-legacy.css';
---
<Base bodyClass="home">
  <!-- Point-cloud scan: one fixed canvas, positioned over the hero / work rail by scan.js -->
  <canvas class="scan-canvas" id="scan-canvas" aria-hidden="true"></canvas>

  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Work />
    <Experience />
    <Contact />
  </main>
  <Footer />

  {projects.map((p) => (
    <template id={`case-${p.slug}`} data-title={p.title}>
      <CaseStudy slug={p.slug} />
    </template>
  ))}
  <Overlay />

  <script>
    import '../scripts/home.js';
  </script>
</Base>
