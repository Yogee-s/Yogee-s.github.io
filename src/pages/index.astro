          <!-- Overview · problem → my part → result, then the headline numbers -->
          <section class="cs-overview" id="rc-overview">
            <dl class="cs-brief">
              <div>
                <dt>The problem</dt>
                <dd>An elderly-care companion has to feel personal, but cloud assistants <mark>send private
                    conversations off the device</mark> and stop working without Wi-Fi.</dd>
              </div>
              <div>
                <dt>My part</dt>
                <dd>I built the <mark>whole robot solo</mark>: the moving head, the electronics, and the vision, voice
                  and AI software.</dd>
              </div>
              <div>
                <dt>The result</dt>
                <dd>A robot that <mark>reads your mood and replies with a matching face</mark>, running fully offline
                  on one Jetson Orin Nano.</dd>
              </div>
            </dl>
            <div class="cs-stats">
              <div><b>≤800 ms</b><span>From your last word to its reply</span></div>
              <div><b>Offline</b><span>Nothing leaves the robot</span></div>
              <div><b>13</b><span>Mood-matched expressions</span></div>
              <div><b>6</b><span>Hardware versions of the head</span></div>
            </div>
            <div class="cs-hero" style="--ar-sum: 1.559">
              <figure style="--ar: 0.75">
                <img class="js-lightbox" src="assets/robotic_companion/robot_happy_face.jpg"
