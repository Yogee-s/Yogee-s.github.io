---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="scroll-progress-bar" id="scroll-progress"></div>
  <div class="bg-noise"></div>

  <header class="topbar" id="topbar">
    <div class="brand-group">
      <span class="brand-bot" aria-hidden="true">
        <span class="brand-bot-head">
          <span class="brand-bot-eye"></span>
          <span class="brand-bot-eye"></span>
        </span>
      </span>
      <a class="brand" href="#home">Yogee<span>.</span></a>
    </div>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false"
      aria-controls="main-nav">☰</button>
    <nav id="main-nav">
      <a href="#featured">Projects</a>
      <a href="#resume">Experience</a>
      <a href="#contact">Contact</a>
      <button id="robot-guide-trigger" class="robot-guide-trigger" type="button" aria-label="Summon robot guide">Guide
        Me</button>
    </nav>
  </header>

  <main>
    <!-- ===== HERO ===== -->
    <section id="home" class="hero reveal">
      <canvas id="particle-canvas"></canvas>
      <div class="hero-top">
        <div class="hero-content">
          <p class="eyebrow" data-anim="hero">Robotics Software & Embodied AI</p>
          <h1 data-anim="hero">Muthukumaran Yogeeswaran</h1>
          <div class="hero-subtitle" data-anim="hero">
            <span id="typed-text"></span><span class="typing-cursor"></span>
          </div>
          <p class="lead" data-anim="hero">
            Building <span class="signal-strong">software-first robotics</span> · ROS architecture, perception models,
            Reinforcement Learning, and human–robot interaction.
          </p>

          <div class="cta-row" data-anim="hero">
            <a class="btn btn-primary" href="assets/resume.pdf" target="_blank" rel="noopener noreferrer">↓ Resume
              PDF</a>
            <a class="btn btn-ghost" href="https://www.linkedin.com/in/yogee-s" target="_blank"
              rel="noopener noreferrer">LinkedIn</a>
            <a class="btn btn-ghost" href="https://github.com/Yogee-s" target="_blank"
              rel="noopener noreferrer">GitHub</a>
          </div>

          <div class="scroll-indicator" data-anim="hero">
            <span class="arrow">↓</span> Scroll to explore
          </div>
        </div>

        <figure class="hero-photo" data-anim="hero">
          <img src="assets/personal_photo.jpg" alt="Portrait of Muthukumaran Yogeeswaran" loading="eager">
        </figure>
      </div>

      <div class="hero-meta">
        <article class="meta-card">
          <div class="meta-card-head">
            <h3>Availability</h3>
            <span class="meta-status"><span class="availability-dot"></span>Available now</span>
          </div>
          <ul class="meta-list">
            <li>Full-time <span class="signal-strong">robotics software roles</span></li>
            <li>Perception · embodied AI · on-device LLMs</li>
            <li>Singapore · open to relocation · NUS BEng '26</li>
          </ul>
        </article>
        <article class="meta-card">
          <h3>Stack</h3>
          <p class="stack-pills">
            <span class="skill-pill skill-pill-violet">Python</span>
            <span class="skill-pill skill-pill-amber">ROS2</span>
            <span class="skill-pill skill-pill-cyan">YOLO</span>
            <span class="skill-pill skill-pill-violet">RL</span>
            <span class="skill-pill skill-pill-rose">LLM</span>
            <span class="skill-pill skill-pill-violet">Simulation</span>
            <span class="skill-pill skill-pill-pink">SolidWorks</span>
            <span class="skill-pill skill-pill-pink">Embedded (STM32)</span>
          </p>
        </article>
        <article class="meta-card">
          <h3>Focus</h3>
          <p><span class="signal-strong">End-to-end robot software</span> · perception, decision-making, and real-time
            control.</p>
        </article>
      </div>
    </section>

    <!-- ===== PROJECT CONSTELLATION ===== -->
    <section id="featured" class="section reveal">
      <div class="section-head">
        <p class="eyebrow">Selected Works</p>
        <h2>Featured Projects</h2>
        <p class="featured-intro">I am passionate about <span class="signal-strong">embodied robotics</span>. Through my
          projects, I have built hands-on experience in <span class="signal-tech">perception</span>, <span
            class="signal-tech">reasoning</span>, <span class="signal-tech">manipulation</span>, and <span
            class="signal-tech">legged balance</span>.</p>
      </div>

      <div class="constellation-wrap">
        <svg id="robot-link-layer" aria-hidden="true"></svg>

        <article class="robot-stage" id="robot-stage" aria-live="polite">
          <div class="robot-stage-head">
            <h3 id="robot-focus-title">Pick a project</h3>
            <p id="robot-focus-desc">Select a project to see the subsystem it targets.</p>
          </div>

          <div class="robot-model-shell">
            <model-viewer id="humanoid-model" src="assets/models/humanoid_mannequin.glb"
              alt="High-fidelity humanoid mannequin used as an interactive project-to-body-part map" camera-controls
              disable-pan interaction-prompt="none" interpolation-decay="120" camera-orbit="0deg 88deg 4.1m"
              min-camera-orbit="auto auto 2.45m" max-camera-orbit="auto auto 4.8m" camera-target="0m 0m 0m"
              shadow-intensity="0.18" exposure="1.2" environment-image="neutral">
              <button class="robot-hotspot" slot="hotspot-fullbody" data-project="boxbunny"
                data-position="-0.58m 0.18m 0.02m" data-normal="0m 1m 0m">
                <span class="hotspot-dot"></span><span class="hotspot-label">BoxBunny</span>
              </button>
              <button class="robot-hotspot" slot="hotspot-eyes" data-project="teleco" data-position="0.07m 0.79m 0.12m"
                data-normal="0m 0m 1m">
                <span class="hotspot-dot"></span><span class="hotspot-label">Teleco</span>
              </button>
              <button class="robot-hotspot" slot="hotspot-head" data-project="breaking-bias"
                data-position="0.02m 0.88m 0.08m" data-normal="0m 1m 0m">
                <span class="hotspot-dot"></span><span class="hotspot-label">Breaking Bias</span>
              </button>
              <button class="robot-hotspot" slot="hotspot-hand" data-project="astar-rl" data-position="0.48m 0.38m 0m"
                data-normal="1m 0m 0m">
                <span class="hotspot-dot"></span><span class="hotspot-label">RL Hand</span>
              </button>
              <button class="robot-hotspot" slot="hotspot-legs" data-project="idp" data-position="-0.34m -0.72m 0.04m"
                data-normal="0m -1m 0m">
                <span class="hotspot-dot"></span><span class="hotspot-label">Legged Balance</span>
              </button>
              <button class="robot-hotspot" slot="hotspot-chest" data-project="robotic-companion"
                data-position="-0.12m 0.40m 0.16m" data-normal="0m 0m 1m">
                <span class="hotspot-dot"></span><span class="hotspot-label">Companion</span>
              </button>
            </model-viewer>
          </div>

          <div class="robot-stage-meta">
            <span class="robot-stage-part" id="robot-part-label">Hover a project to preview subsystem focus.</span>
            <span class="robot-stage-project" id="robot-project-label">Click a project to lock focus and open
              details.</span>
          </div>
          <p class="robot-model-credit">3D model: <a href="https://poly.pizza/m/qbDLeTtb8K" target="_blank"
              rel="noopener noreferrer">Character Base</a> by madtrollstudio (CC-BY 3.0).</p>
        </article>

        <div class="robot-project-grid" id="robot-project-grid">
          <article class="card-node" data-project="boxbunny" tabindex="0" role="button" aria-controls="detail-panel"
            aria-label="Open BoxBunny project details">
            <div class="node-visual">
              <img src="assets/boxbunny_capstone/concept_design.jpg" alt="BoxBunny Robot" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">Final Year Project</span>
              <h3>BoxBunny</h3>
              <p class="card-node-role">Intelligence Lead · Capstone</p>
              <p class="card-node-summary">Adaptive AI boxing sparring partner and coach.</p>
              <div class="card-node-tags">
                <span>ROS 2</span><span>Jetson</span><span>Transformer</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>

          <article class="card-node" data-project="robotic-companion" tabindex="0" role="button" aria-controls="detail-panel"
            aria-label="Open Robotic Companion project details">
            <div class="node-visual">
              <img src="assets/robotic_companion/robot_happy_face.jpg" alt="Robotic Companion with happy expression" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">UREx · Solo</span>
              <h3>Companion</h3>
              <p class="card-node-role">Solo Researcher · NUS</p>
              <p class="card-node-summary">Self-proposed offline AI companion for elderly care.</p>
              <div class="card-node-tags">
                <span>Jetson</span><span>On-device LLM</span><span>ESP32</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>

          <article class="card-node" data-project="teleco" tabindex="0" role="button" aria-controls="detail-panel"
            aria-label="Open Teleco project details">
            <div class="node-visual">
              <img src="assets/frontier/close_up_teleco_robot.jpg" alt="Teleco Robot" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">Deployed</span>
              <h3>Teleco</h3>
              <p class="card-node-role">Research Intern · Osaka</p>
              <p class="card-node-summary">Deployed at Osaka Expo 2025. YOLOv12 + SLAM for social robot gaze.</p>
              <div class="card-node-tags">
                <span>YOLOv12</span><span>SLAM</span><span>Kabsch</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>

          <article class="card-node" data-project="breaking-bias" tabindex="0" role="button"
            aria-controls="detail-panel" aria-label="Open Breaking Bias project details">
            <div class="node-visual">
              <img src="assets/breaking_bias/Breaking_bias_node.png" alt="Breaking Bias" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">LLM Research</span>
              <h3>Breaking Bias</h3>
              <p class="card-node-role">AI Safety Research</p>
              <p class="card-node-summary">Analyzing and mitigating bias in Large Language Models.</p>
              <div class="card-node-tags">
                <span>LLMs</span><span>Python</span><span>PyTorch</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>

          <article class="card-node" data-project="astar-rl" tabindex="0" role="button" aria-controls="detail-panel"
            aria-label="Open RL Dexterous Hand project details">
            <div class="node-visual">
              <img src="assets/artc_internship/RL_node.png" alt="RL Dexterous Hand" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">Research</span>
              <h3>RL Hand</h3>
              <p class="card-node-role">Research Intern · A*STAR</p>
              <p class="card-node-summary">Sim-to-real reinforcement learning for dexterous manipulation.</p>
              <div class="card-node-tags">
                <span>MuJoCo</span><span>RL / DAPG</span><span>URDF</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>

          <article class="card-node" data-project="idp" tabindex="0" role="button" aria-controls="detail-panel"
            aria-label="Open Legged Balancing Robot project details">
            <div class="node-visual">
              <img src="assets/idp_projects/eg3301r_2_legged_balancing.jpg" alt="Balancing Robot" loading="lazy">
              <div class="node-overlay"></div>
            </div>
            <div class="node-content">
              <span class="card-node-pill">Foundation</span>
              <h3>Legged Balance</h3>
              <p class="card-node-role">NUS IDP · 2022-2024</p>
              <p class="card-node-summary">Self-balancing robot with 3-axis stabilized gimbal.</p>
              <div class="card-node-tags">
                <span>PID/LQR</span><span>SolidWorks</span><span>STM32</span>
              </div>
              <button class="card-node-open" type="button">Open Project</button>
            </div>
          </article>
        </div>
      </div>

      <!-- Poster Gallery + Other Projects (side by side) -->
      <div class="poster-and-other-wrap">
        <div class="poster-section">
          <h3 class="poster-section-title"><span class="guide-section-label">Poster Gallery</span></h3>
          <p class="poster-section-note">I love designing posters and put strong emphasis on making information easy to
            understand at a glance. For LifeQuest, I designed both the game mechanics and its poster visuals.</p>
          <div class="poster-grid">
            <figure class="poster-card card">
              <img class="js-lightbox" src="assets/idp_projects/balancing_robot_poster.webp"
                alt="IDP balancing robot poster" loading="lazy">
              <figcaption>Balancing Robot</figcaption>
            </figure>
            <figure class="poster-card card">
              <img class="js-lightbox" src="assets/orbital/orbital_first_poster.jpg" alt="Orbital first poster"
                loading="lazy">
              <figcaption>Orbital v1</figcaption>
            </figure>
            <figure class="poster-card card">
              <img class="js-lightbox" src="assets/orbital/orbital_final_poster.jpg" alt="Orbital final poster"
                loading="lazy">
              <figcaption>Orbital Final</figcaption>
            </figure>
          </div>
        </div>

        <!-- Other Projects row -->
        <div class="other-projects">
          <h3 class="other-projects-title"><span class="guide-section-label">Other Projects</span></h3>
          <div class="other-projects-grid">
            <article class="card other-card">
              <h4>LifeQuest (NUS Orbital)</h4>
              <p class="meta">Co-Lead · May – Aug 2023</p>
              <div class="tech-tags">
                <span class="tech-tag">React Native</span>
                <span class="tech-tag">Firebase</span>
              </div>
              <p>Gamified productivity app with auth, progress tracking, and social battles.</p>
              <div class="links">
                <a href="assets/orbital/milestone_3_submission.pdf" target="_blank" rel="noopener noreferrer">Report</a>
                <a href="https://github.com/Yogee-s/NUS-Orbital-2023" class="card-repo-btn" target="_blank"
                  rel="noopener noreferrer">
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path
                      d="M8 0c-4.42 0-8 3.58-8 8 0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38a8.013 8.013 0 0 0-5.55-7.97z">
                    </path>
                  </svg>
                  GitHub
                </a>
              </div>
            </article>

          </div>
        </div>
      </div>
    </section>



    <!-- ===== PROJECT TEMPLATES ===== -->
    <template id="tpl-boxbunny">
      <!-- Outline · its own rail on the left of the panel (chip strip on phones) -->
      <nav class="cs-toc" aria-label="Sections in this project">
        <span class="cs-toc-label">On this page</span>
        <ol>
          <li class="cs-toc-top"><a href="#bb-overview">Overview</a></li>
          <li><a href="#bb-demo"><b>01</b> See it work</a></li>
          <li><a href="#bb-model"><b>02</b> Building the model</a>
            <ol>
              <li><a href="#bb-model-data">Record + label</a></li>
              <li><a href="#bb-model-tries">Exploring features</a></li>
              <li><a href="#bb-model-check">Interpretability</a></li>
              <li><a href="#bb-model-final">The final model</a></li>
            </ol>
          </li>
          <li><a href="#bb-runtime"><b>03</b> Running it live</a></li>
          <li><a href="#bb-app"><b>04</b> Phone app + AI coach</a>
            <ol>
              <li><a href="#bb-app-dash">Phone dashboard</a></li>
              <li><a href="#bb-app-coach">AI coach</a></li>
              <li><a href="#bb-app-tuning">Tuning</a></li>
            </ol>
          </li>
        </ol>
      </nav>
      <article class="detail-project">
        <div class="project-head">
          <div>
            <h2>BoxBunny: Intelligent Boxing Robot</h2>
            <p class="meta"><span class="signal-strong">Robot Intelligence Lead</span> · CDE4301 Final-Year Capstone ·
              Aug 2025 – Apr 2026</p>
            <div class="tech-tags">
              <span class="tech-tag">ROS 2 Humble</span><span class="tech-tag">Jetson Orin NX</span>
              <span class="tech-tag">Voxel-Pose Transformer</span><span class="tech-tag">TensorRT FP16</span>
              <span class="tech-tag">CV+IMU Fusion</span><span class="tech-tag">Grad-CAM</span>
              <span class="tech-tag">On-device LLM</span>
            </div>
          </div>
          <span class="pill">Final Year Project</span>
        </div>
        <div class="project-body boxing-body cs">
          <div class="links cta-top" style="align-items: center;">
            <a href="https://cheer-up-dimbo.github.io/IS431/pages/robot-intelligence.html" class="btn btn-primary"
              target="_blank" rel="noopener noreferrer">Read the Full Deep-Dive</a>
            <a href="https://github.com/Yogee-s/boxing_action_recognition" class="card-repo-btn" target="_blank"
              rel="noopener noreferrer">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  d="M8 0c-4.42 0-8 3.58-8 8 0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38a8.013 8.013 0 0 0-5.55-7.97z">
                </path>
              </svg>
              ML Repo
            </a>
            <a href="https://github.com/Yogee-s/boxing_robot_ws" class="card-repo-btn" target="_blank"
              rel="noopener noreferrer">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  d="M8 0c-4.42 0-8 3.58-8 8 0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38a8.013 8.013 0 0 0-5.55-7.97z">
                </path>
              </svg>
              ROS 2 Repo
            </a>
          </div>

          <!-- Overview · problem → my part → result, then the headline numbers -->
          <section class="cs-overview" id="bb-overview">
            <dl class="cs-brief">
              <div>
                <dt>The problem</dt>
                <dd>Boxing robots run scripted drills. We wanted one that <mark>reacts to real punches</mark>, even
                  with gloves hiding the hands.</dd>
              </div>
              <div>
                <dt>My part</dt>
                <dd>I built the <mark>robot's brain</mark>: punch recognition, real-time software, phone app and AI
                  coach.</dd>
              </div>
              <div>
                <dt>The result</dt>
                <dd>Real-time punch recognition <mark>running fully on the robot</mark>, demoed at the CDE AI Fair.</dd>
              </div>
            </dl>
            <div class="cs-stats">
              <div><b>96.8%</b><span>Accuracy on unseen boxers</span></div>
              <div><b>30 fps</b><span>Real-time on the robot</span></div>
              <div><b>9</b><span>Model versions to get there</span></div>
              <div><b>On-device</b><span>No cloud, all on the robot</span></div>
            </div>
            <div class="cs-hero" style="--ar-sum: 2.333">
              <figure style="--ar: 1">
                <img class="js-lightbox" src="assets/boxbunny_capstone/concept_design.jpg"
                  alt="BoxBunny concept design" loading="lazy">
                <figcaption>Concept design</figcaption>
              </figure>
              <figure style="--ar: 1.333">
                <img class="js-lightbox" src="assets/boxbunny_capstone/cde_fair_setup.jpg"
                  alt="BoxBunny deployed at CDE AI Fair" loading="lazy">
                <figcaption>Deployed at CDE AI Fair</figcaption>
              </figure>
            </div>
          </section>

          <!-- 01 · Demo first, so the reader knows what the rest of the page builds towards -->
          <section class="cs-section" id="bb-demo">
            <header class="cs-section-head">
              <span class="cs-num">01</span>
              <div>
                <h3>See it work</h3>
                <p class="cs-lead">Watch the label in the top-left corner: the model names each punch <mark>the
                    moment it lands</mark>. Two different boxers, same model.</p>
              </div>
            </header>
            <div class="media-layout media-layout-2 cs-video-pair">
              <figure>
                <video controls autoplay loop muted playsinline preload="none" poster="assets/boxbunny_capstone/inference_person_1_poster.webp">
                  <source src="assets/boxbunny_capstone/inference_person_1.mp4" type="video/mp4">
                </video>
                <figcaption>Person 1 · newer boxer, looser form</figcaption>
              </figure>
              <figure>
                <video controls autoplay loop muted playsinline preload="none" poster="assets/boxbunny_capstone/inference_person_2_poster.webp">
                  <source src="assets/boxbunny_capstone/inference_person_2.mp4" type="video/mp4">
                </video>
